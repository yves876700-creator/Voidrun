        ========================================== */
        function setupControls() {
            window.addEventListener('keydown', (e) => {
                if (e.code === 'Space') {
                    e.preventDefault();
                    if (!e.repeat) queueJumpInput();
                }
                keys[e.code] = true;
                if (e.code === 'KeyE' || e.code === 'AltLeft') performDash();
                if (e.code === 'KeyC' || e.code === 'ControlLeft') performSlideOrDive();
                if (e.code === 'KeyR') restartGameCompletely();
                if (e.code === 'KeyB') toggleFieldbookModal();
            });

            window.addEventListener('keyup', (e) => { keys[e.code] = false; });

            const container = document.getElementById('game-container');

            // Free camera drag: mouse on desktop, one-finger drag on mobile.
            // Ignore HUD and virtual control buttons so gameplay taps remain reliable.
            container.style.touchAction = 'none';
            container.addEventListener('pointerdown', (e) => {
                if (!isGameRunning || e.button !== 0) return;
                if (e.target.closest('#hud, #touch-controls, #tutorial-card, button, input, a')) return;
                cameraDragPointerId = e.pointerId;
                cameraLastX = e.clientX;
                cameraLastY = e.clientY;
                if (container.setPointerCapture) {
                    try { container.setPointerCapture(e.pointerId); } catch (_) {}
                }
                e.preventDefault();
            });

            container.addEventListener('pointermove', (e) => {
                if (cameraDragPointerId !== e.pointerId || !isGameRunning) return;
                const dx = e.clientX - cameraLastX;
                const dy = e.clientY - cameraLastY;
                cameraOrbitYaw -= dx * 0.005;
                cameraOrbitPitch -= dy * 0.004;
                cameraOrbitPitch = Math.max(-1.05, Math.min(0.75, cameraOrbitPitch));
                cameraLastX = e.clientX;
                cameraLastY = e.clientY;
                e.preventDefault();
            });

            const endCameraDrag = (e) => {
                if (cameraDragPointerId === e.pointerId) {
                    cameraDragPointerId = null;
                    if (container.releasePointerCapture) {
                        try { container.releasePointerCapture(e.pointerId); } catch (_) {}
                    }
                }
            };
            container.addEventListener('pointerup', endCameraDrag);
            container.addEventListener('pointercancel', endCameraDrag);
            container.addEventListener('lostpointercapture', endCameraDrag);

            // Left Virtual Joystick
            const joystickZone = document.getElementById('joystick-zone');
            const joystickKnob = document.getElementById('joystick-knob');
            let joystickTouchId = null;

            joystickZone.addEventListener('touchstart', (e) => {
                const touch = e.changedTouches[0];
                joystickTouchId = touch.identifier;
                updateJoystick(touch);
            }, { passive: true });

            window.addEventListener('touchmove', (e) => {
                if (joystickTouchId === null) return;
                for (let i = 0; i < e.touches.length; i++) {
                    if (e.touches[i].identifier === joystickTouchId) {
                        updateJoystick(e.touches[i]);
                        break;
                    }
                }
            }, { passive: true });

            window.addEventListener('touchend', (e) => {
                if (joystickTouchId === null) return;
                for (let i = 0; i < e.changedTouches.length; i++) {
                    if (e.changedTouches[i].identifier === joystickTouchId) {
                        joystickTouchId = null;
                        touchInput.x = 0;
                        touchInput.y = 0;
                        touchInput.isActive = false;
                        joystickKnob.style.transform = `translate(0px, 0px)`;
                        break;
                    }
                }
            });

            function updateJoystick(touch) {
                const rect = joystickZone.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;

                let dx = touch.clientX - centerX;
                let dy = touch.clientY - centerY;
                const maxLen = rect.width / 2;
                const dist = Math.hypot(dx, dy);

                if (dist > maxLen) {
                    dx = (dx / dist) * maxLen;
                    dy = (dy / dist) * maxLen;
                }

                joystickKnob.style.transform = `translate(${dx}px, ${dy}px)`;
                touchInput.x = (dx / maxLen) * 0.85;
                touchInput.y = (dy / maxLen) * 0.85;
                touchInput.isActive = true;
            }

