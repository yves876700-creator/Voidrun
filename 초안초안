        function initAudio() {
            if (!synth && typeof Tone !== 'undefined') {
                synth = new Tone.PolySynth(Tone.Synth, {
                    oscillator: { type: "square" }, // 8-bit chiptune square wave!
                    envelope: { attack: 0.005, decay: 0.12, sustain: 0.02, release: 0.1 }
                }).toDestination();
                synth.volume.value = -14;
            }
        }

        function playSfx(type) {
            if (!soundEnabled || !synth) return;
            try {
                if (Tone.context.state !== 'running') Tone.start();
                const now = Tone.now();
                if (type === 'jump') synth.triggerAttackRelease("C5", "32n", now);
                else if (type === 'doubleJump') synth.triggerAttackRelease("G5", "32n", now);
                else if (type === 'wallJump') synth.triggerAttackRelease("A5", "32n", now);
                else if (type === 'dash') synth.triggerAttackRelease(["E4", "B4"], "32n", now);
                else if (type === 'bounce') {
                    synth.triggerAttackRelease("C5", "32n", now);
                    synth.triggerAttackRelease("G5", "32n", now + 0.05);
                    synth.triggerAttackRelease("C6", "16n", now + 0.1);
                } else if (type === 'token') {
                    synth.triggerAttackRelease("E5", "32n", now);
                    synth.triggerAttackRelease("G5", "32n", now + 0.06);
                    synth.triggerAttackRelease("C6", "16n", now + 0.12);
                } else if (type === 'checkpoint') {
                    synth.triggerAttackRelease("C5", "32n", now);
                    synth.triggerAttackRelease("E5", "32n", now + 0.07);
                    synth.triggerAttackRelease("G5", "16n", now + 0.14);
                } else if (type === 'clear') {
                    synth.triggerAttackRelease(["C5", "E5", "G5", "C6"], "8n", now);
                } else if (type === 'die') {
                    synth.triggerAttackRelease("G2", "8n", now);
                    synth.triggerAttackRelease("C2", "4n", now + 0.1);
                }
            } catch (e) { /* Ignore audio context warnings */ }
        }

