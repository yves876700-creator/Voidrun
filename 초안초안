        /* ==========================================
           PIXEL FALLING LEAVES & POLLEN PARTICLES
        ========================================== */
        function createAutumnParticles() {
            const count = 550;
            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(count * 3);
            const velocities = new Float32Array(count * 3);

            for (let i = 0; i < count; i++) {
                positions[i * 3] = (Math.random() - 0.5) * 180;
                positions[i * 3 + 1] = Math.random() * 60 + 5;
                positions[i * 3 + 2] = (Math.random() - 0.5) * 360;

                velocities[i * 3] = (Math.random() - 0.5) * 0.9;
                velocities[i * 3 + 1] = -Math.random() * 1.2 - 0.5;
                velocities[i * 3 + 2] = (Math.random() - 0.5) * 0.9;
            }

            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            const material = new THREE.PointsMaterial({ size: 0.5, color: 0xfbbf24, transparent: true, opacity: 0.9 });
            const particles = new THREE.Points(geometry, material);
            particles.userData = { velocities: velocities };
            scene.add(particles);

            scene.userData.updateParticles = (delta) => {
                const pos = geometry.attributes.position.array;
                const vel = particles.userData.velocities;
                for (let i = 0; i < count; i++) {
                    pos[i * 3] += vel[i * 3] * delta;
                    pos[i * 3 + 1] += vel[i * 3 + 1] * delta;
                    pos[i * 3 + 2] += vel[i * 3 + 2] * delta;

                    if (pos[i * 3 + 1] < -10) {
                        pos[i * 3] = player.position.x + (Math.random() - 0.5) * 120;
                        pos[i * 3 + 1] = player.position.y + 40;
                        pos[i * 3 + 2] = player.position.z + (Math.random() - 0.5) * 120;
                    }
                }
                geometry.attributes.position.needsUpdate = true;
            };
        }

        /* ==========================================
           LEVEL DESIGN WITH PIXEL TEXTURED MATERIALS
        ========================================== */
        function makeTiledMat(baseTex, w, d) {
            const tex = baseTex.clone();
            tex.needsUpdate = true;
            tex.repeat.set(Math.max(1, Math.round(w / 2)), Math.max(1, Math.round(d / 2)));
            return new THREE.MeshLambertMaterial({ map: tex });
        }

        function buildAutumnLevel() {
            function addPlatform(x, y, z, w, h, d, texType = 'stone', isWall = false) {
                const geo = new THREE.BoxGeometry(w, h, d);
                const mat = makeTiledMat(PIXEL_TEXTURES[texType], w, isWall ? h : d);
                const mesh = new THREE.Mesh(geo, mat);
                mesh.position.set(x, y, z);
                mesh.receiveShadow = true;
                mesh.castShadow = true;
                mesh.userData = { w, h, d, isWall, initialPos: new THREE.Vector3(x, y, z) };
                scene.add(mesh);
                platforms.push(mesh);
                if (isWall) wallPlatforms.push(mesh);
                return mesh;
            }

            function addCrumblingPlatform(x, y, z, w, h, d, delay = 0.8) {
                const mesh = addPlatform(x, y, z, w, h, d, 'crumble');
                mesh.userData.isCrumbling = true;
                mesh.userData.crumbleDelay = delay;
                mesh.userData.timer = 0;
                mesh.userData.triggered = false;
                mesh.userData.initialY = y;
                crumblingPlats.push(mesh);
            }

            function addMovingPlatform(x, y, z, w, h, d, moveVector, speed = 2) {
                const mesh = addPlatform(x, y, z, w, h, d, 'gold');
                mesh.userData.startPos = new THREE.Vector3(x, y, z);
                mesh.userData.moveVector = moveVector;
                mesh.userData.speed = speed;
                mesh.userData.progress = 0;
                movingPlats.push(mesh);
            }

            function addToken(x, y, z, sampleIndex) {
                const group = new THREE.Group();
                // Pixel Crystal Specimen Box
                const geo = new THREE.BoxGeometry(0.75, 0.75, 0.75);
                const mat = new THREE.MeshLambertMaterial({ color: 0xfacc15, emissive: 0xca8a04, emissiveIntensity: 0.4 });
                const core = new THREE.Mesh(geo, mat);
                group.add(core);

                // Square Pixel Orbit Frame
                const frameGeo = new THREE.BoxGeometry(1.1, 0.12, 1.1);
                const frameMat = new THREE.MeshBasicMaterial({ color: 0xfef08a });
                const frame = new THREE.Mesh(frameGeo, frameMat);
                group.add(frame);

                group.position.set(x, y, z);
                group.userData = { sampleIndex: sampleIndex };
                scene.add(group);
                tokens.push(group);
            }

            function addCheckpoint(x, y, z, index) {
                // Retro Wooden Camp Archway
                const archGroup = new THREE.Group();
                const postMat = new THREE.MeshLambertMaterial({ color: 0xf59e0b, emissive: 0x92400e, emissiveIntensity: 0.3 });
                const leftPost = new THREE.Mesh(new THREE.BoxGeometry(0.35, 3.2, 0.35), postMat);
                leftPost.position.set(-1.6, 1.6, 0);
                const rightPost = new THREE.Mesh(new THREE.BoxGeometry(0.35, 3.2, 0.35), postMat);
                rightPost.position.set(1.6, 1.6, 0);
                const topBeam = new THREE.Mesh(new THREE.BoxGeometry(3.8, 0.4, 0.45), postMat);
                topBeam.position.set(0, 3.2, 0);

                archGroup.add(leftPost, rightPost, topBeam);
