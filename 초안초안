                scene.add(archGroup);
                checkpoints.push({ position: new THREE.Vector3(x, y + 1, z), index: index, mesh: topBeam, postMat: postMat, activated: false });
            }

            function addBoss(x, y, z, stage, bossName) {
                const boss = new THREE.Group();
                const shellMat = new THREE.MeshLambertMaterial({ color: stage === 10 ? 0x7f1d1d : 0x312e81, emissive: stage === 10 ? 0x450a0a : 0x1e1b4b, emissiveIntensity: 0.55 });
                const coreMat = new THREE.MeshBasicMaterial({ color: 0x64748b });
                const shell = new THREE.Mesh(new THREE.SphereGeometry(2.15, 8, 6), shellMat);
                const core = new THREE.Mesh(new THREE.OctahedronGeometry(0.95, 0), coreMat);
                boss.add(shell, core);
                core.position.set(0, 0, 1.8);
                for (let i = 0; i < 6; i++) {
                    const spike = new THREE.Mesh(new THREE.ConeGeometry(0.42, 1.5, 4), shellMat);
