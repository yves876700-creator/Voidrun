        /* ==========================================
           PARKOUR ACTIONS (WITH COYOTE TIME & JUMP BUFFER)
        ========================================== */
        function queueJumpInput() {
            if (!isGameRunning) return;
            player.jumpBufferTimer = CONFIG.jumpBufferTime;
            tryExecuteBufferedJump();
        }

        function tryExecuteBufferedJump() {
            if (!isGameRunning || player.jumpBufferTimer <= 0) return false;

            // 1. 벽타기 도약 우선 처리
            if (player.isTouchingWall && player.wallJumpCooldown <= 0) {
                player.velocity.y = CONFIG.wallJumpForce;
                const pushDir = player.wallNormal.clone().multiplyScalar(7.5);
                player.velocity.x = pushDir.x;
                player.velocity.z = -8.2;
                player.canDoubleJump = true;
                player.wallJumpCooldown = 0.2;
                player.coyoteTimer = 0;
                player.jumpBufferTimer = 0;
                playSfx('wallJump');
                showToast("게코 벽타기 도약!");
                return true;
            }

            // 2. 지상 점프 또는 넉넉한 코요테 타임(0.28초) 내 점프
            if (player.isGrounded || player.coyoteTimer > 0) {
                const wasCoyote = !player.isGrounded && player.coyoteTimer > 0;
                player.velocity.y = CONFIG.jumpForce;
                player.isGrounded = false;
                player.coyoteTimer = 0;
                player.jumpBufferTimer = 0;
                player.canDoubleJump = true;
                // 지상에서 활공을 미리 입력했다면 전방 점프와 동시에 활공 상태로 전환.
                if (player.glideQueued) {
                    player.isGliding = true;
                    player.glideQueued = false;
                    player.velocity.y = Math.max(player.velocity.y, 1.8);
                    const glideForward = new THREE.Vector3(0, 0, -1).applyAxisAngle(new THREE.Vector3(0, 1, 0), player.rotationY);
                    player.velocity.x = glideForward.x * player.glideSpeed;
                    player.velocity.z = glideForward.z * player.glideSpeed;
                }
                playSfx('jump');
                if (wasCoyote) showToast("코요테 점프!");
                return true;
            }

            // 3. 공중 2단 점프 (점프 선입력 버퍼가 막 시작된 시점에만 발동)
            if (player.canDoubleJump && player.jumpBufferTimer >= CONFIG.jumpBufferTime - 0.035) {
                player.velocity.y = CONFIG.jumpForce * 0.95;
                player.canDoubleJump = false;
                player.jumpBufferTimer = 0;
                playSfx('doubleJump');
                showToast("2단 점프!");
                return true;
            }

            return false;
        }

        function performDash() {
            if (!isGameRunning || player.stamina < CONFIG.staminaDashCost || player.dashCooldown > 0) return;
            player.stamina -= CONFIG.staminaDashCost;
            player.staminaRegenTimer = CONFIG.staminaRegenDelay;
            player.dashCooldown = 0.45;

            const dashDir = new THREE.Vector3(0, 0, -1).applyAxisAngle(new THREE.Vector3(0, 1, 0), player.rotationY);
            player.velocity.x = dashDir.x * CONFIG.dashForce;
            player.velocity.z = dashDir.z * CONFIG.dashForce;
            player.velocity.y = 2.6;
            player.dashVisualTimer = 0.42;
            let bossHit = false;
            for (const boss of bosses) {
                const data = boss.userData;
                if (!data.defeated && data.vulnerableTimer > 0 && player.position.distanceTo(boss.position) < 6.4) {
                    data.hp -= 1;
                    bossHit = true;
                    data.vulnerableTimer = 0;
                    showToast(`${data.bossName} 핵 타격! 남은 체력 ${Math.max(0, data.hp)}/${data.maxHp}`);
                    if (data.hp <= 0) {
                        data.defeated = true;
                        boss.visible = false;
                        for (let i = bossProjectiles.length - 1; i >= 0; i--) {
                            scene.remove(bossProjectiles[i]);
                            bossProjectiles.splice(i, 1);
                        }
                        showToast(`${data.bossName} 격파! 길이 열렸습니다!`);
                        playSfx('clear');
                    }
                }
            }
            playSfx('dash');
            if (!bossHit) showToast("질풍 대시!");
        }

        function activateSprintBoost() {
            if (!isGameRunning) return;
            player.sprintBoostTimer = 10.0;
            player.potionAnimTimer = 0.9;
            playSfx('dash');
            showToast("질주 가속! 10초 동안 속도 +15%");
        }

        function performSlideOrDive() {
            if (!isGameRunning) return;

            // 슬라이드 버튼은 활공 모드의 ON/OFF 토글로 동작한다.
            if (player.isGliding || player.glideQueued) {
                player.isGliding = false;
                player.glideQueued = false;
                showToast("활공 모드 해제!");
                return;
            }

            // 지상에서 켜도 모드를 유지하고, 점프하는 순간 활공이 적용된다.
            player.isGliding = true;
            if (player.isGrounded) {
                player.glideQueued = true;
                player.isSliding = false;
                showToast("활공 모드 ON · 점프하면 활공!");
            } else {
                player.glideQueued = false;
                player.velocity.y = Math.max(player.velocity.y, -1.2);
                const forward = new THREE.Vector3(0, 0, -1).applyAxisAngle(
                    new THREE.Vector3(0, 1, 0), player.rotationY
                );
                player.velocity.x = forward.x * player.glideSpeed;
                player.velocity.z = forward.z * player.glideSpeed;
                showToast("활공 모드 ON!");
            }
        }

        function performDive() {
            if (!player.isGrounded) {
                player.velocity.y = -CONFIG.gravity * 1.3;
                showToast("수직 급강하!");
            }
        }

        /* ==========================================
           PHYSICS & COLLISIONS
        ========================================== */
        function updatePhysics(delta) {
            if (!isGameRunning || tutorialCardOpen) return;

            gameTime += delta;
            if (player.dashCooldown > 0) player.dashCooldown -= delta;
            if (player.wallJumpCooldown > 0) player.wallJumpCooldown -= delta;
            if (player.sprintBoostTimer > 0) player.sprintBoostTimer = Math.max(0, player.sprintBoostTimer - delta);
            if (player.dashVisualTimer > 0) player.dashVisualTimer = Math.max(0, player.dashVisualTimer - delta);
            if (player.potionAnimTimer > 0) player.potionAnimTimer = Math.max(0, player.potionAnimTimer - delta);

            // 코요테 타임 및 점프 버퍼 타이머 갱신
            if (player.isGrounded) {
                player.coyoteTimer = CONFIG.coyoteTime;
            } else if (player.coyoteTimer > 0) {
                player.coyoteTimer = Math.max(0, player.coyoteTimer - delta);
            }

            if (player.jumpBufferTimer > 0) {
                if (!tryExecuteBufferedJump()) {
                    player.jumpBufferTimer = Math.max(0, player.jumpBufferTimer - delta);
                }
            }

            if (player.slideTimer > 0) {
                player.slideTimer -= delta;
                if (player.slideTimer <= 0) player.isSliding = false;
            }

            // 대시 직후에는 회복을 잠시 멈춰 연속 대시를 제한한다.
            if (player.staminaRegenTimer > 0) {
                player.staminaRegenTimer = Math.max(0, player.staminaRegenTimer - delta);
            } else if (player.stamina < CONFIG.maxStamina) {
                player.stamina = Math.min(
                    CONFIG.maxStamina,
                    player.stamina + CONFIG.staminaRegen * delta
                );
            }

            let moveX = 0, moveZ = 0;
            if (keys['KeyW'] || keys['ArrowUp']) moveZ -= 1;
            if (keys['KeyS'] || keys['ArrowDown']) moveZ += 1;
            if (keys['KeyA'] || keys['ArrowLeft']) moveX -= 1;
            if (keys['KeyD'] || keys['ArrowRight']) moveX += 1;

            if (touchInput.isActive) {
                moveX = touchInput.x;
                moveZ = touchInput.y;
            }

            player.isSprinting = (keys['ShiftLeft'] || keys['ShiftRight']) && moveZ < 0;
            const baseSpeed = player.isSliding ? CONFIG.sprintSpeed * 1.25 : (player.isSprinting ? CONFIG.sprintSpeed : CONFIG.walkSpeed);
            const currentSpeed = baseSpeed * (player.sprintBoostTimer > 0 ? 1.15 : 1);

            const moveDir = new THREE.Vector3(moveX, 0, moveZ);
            if (moveDir.lengthSq() > 0) moveDir.normalize();
            moveDir.applyAxisAngle(new THREE.Vector3(0, 1, 0), player.rotationY);

            if (player.isTouchingWall && !player.isGrounded) {
                player.velocity.y = Math.max(player.velocity.y, -4.0);
                player.velocity.x = THREE.MathUtils.lerp(player.velocity.x, moveDir.x * currentSpeed, CONFIG.airControl * delta * 8);
                player.velocity.z = THREE.MathUtils.lerp(player.velocity.z, moveDir.z * currentSpeed, CONFIG.airControl * delta * 8);
            } else if (player.isGrounded) {
                player.velocity.x = moveDir.x * currentSpeed;
                player.velocity.z = moveDir.z * currentSpeed;
            } else {
                player.velocity.x = THREE.MathUtils.lerp(player.velocity.x, moveDir.x * currentSpeed, CONFIG.airControl * delta * 10);
                player.velocity.z = THREE.MathUtils.lerp(player.velocity.z, moveDir.z * currentSpeed, CONFIG.airControl * delta * 10);
                player.velocity.y -= CONFIG.gravity * delta;
            }

            // 활공은 점프·대시 등 공중 동작 뒤에도 유지되며, 수평 추진과 완만한 하강을 별도로 적용.
            if (!player.isGrounded && player.isGliding && !player.isTouchingWall) {
                const forward = new THREE.Vector3(0, 0, -1).applyAxisAngle(new THREE.Vector3(0, 1, 0), player.rotationY);
                const glideTarget = player.glideSpeed * (player.isSprinting ? 1.12 : 1);
                player.velocity.x = THREE.MathUtils.lerp(player.velocity.x, forward.x * glideTarget + moveDir.x * 2.2, Math.min(1, delta * 3.5));
                player.velocity.z = THREE.MathUtils.lerp(player.velocity.z, forward.z * glideTarget + moveDir.z * 2.2, Math.min(1, delta * 3.5));
                player.velocity.y = Math.max(player.velocity.y - CONFIG.gravity * 0.10 * delta, -2.4);
            }

            player.position.x += (player.velocity.x + (player.isGrounded ? player.groundVelocity.x : 0)) * delta;
            player.position.y += player.velocity.y * delta;
            player.position.z += (player.velocity.z + (player.isGrounded ? player.groundVelocity.z : 0)) * delta;

            checkPlatformCollisions(delta);

            // 충돌 판정 직후 착지했다면 선입력된 점프 즉시 실행
            if (player.isGrounded && player.jumpBufferTimer > 0) {
                tryExecuteBufferedJump();
            }

            updateCanyonMechanics(delta);
            updateSMAGate(delta);
            updateDynamicTraps(delta);
            checkCollectibles();

            if (player.position.y < -20) onPlayerDie();

            if (player.mesh) {
                player.mesh.position.copy(player.position);
                player.mesh.rotation.y = player.rotationY;
                player.mesh.rotation.x = player.isSliding ? 0.35 : (player.isGliding ? 0.10 : (player.isSprinting ? 0.12 : 0));

                // 이동 속도에 맞춰 발걸음 주기를 갱신해 정지 상태에서는 자연스럽게 멈춘다.
                const horizontalSpeed = Math.hypot(player.velocity.x, player.velocity.z);
                const movingOnGround = player.isGrounded && horizontalSpeed > 0.45 && !player.isSliding;
                if (movingOnGround) {
                    const strideRate = player.isSprinting ? 15.5 : 10.5;
                    player.walkCycle += delta * strideRate * Math.min(1.35, horizontalSpeed / Math.max(CONFIG.walkSpeed, 0.1));
                }
                const stride = movingOnGround ? Math.sin(player.walkCycle) * (player.isSprinting ? 0.78 : 0.56) : 0;
                const airPose = !player.isGrounded && !player.isGliding;
                if (player.leftLegPivot && player.rightLegPivot) {
                    const targetLeft = player.isGliding ? -0.18 : (airPose ? -0.42 : stride);
                    const targetRight = player.isGliding ? -0.18 : (airPose ? 0.30 : -stride);
                    player.leftLegPivot.rotation.x = THREE.MathUtils.lerp(player.leftLegPivot.rotation.x, targetLeft, Math.min(1, delta * 12));
                    player.rightLegPivot.rotation.x = THREE.MathUtils.lerp(player.rightLegPivot.rotation.x, targetRight, Math.min(1, delta * 12));
                }
                if (player.glideLeftArm && player.glideRightArm) {
                    const armSwing = movingOnGround ? stride * 0.72 : 0;
                    const armPose = player.isGliding ? 1.18 : (airPose ? -0.48 : armSwing);
                    player.glideLeftArm.rotation.z = THREE.MathUtils.lerp(player.glideLeftArm.rotation.z, player.isGliding ? 0.82 : 0, Math.min(1, delta * 10));
                    player.glideRightArm.rotation.z = THREE.MathUtils.lerp(player.glideRightArm.rotation.z, player.isGliding ? -0.82 : 0, Math.min(1, delta * 10));
                    player.glideLeftArm.rotation.x = THREE.MathUtils.lerp(player.glideLeftArm.rotation.x, armPose + (movingOnGround ? -armSwing : 0), Math.min(1, delta * 12));
                    player.glideRightArm.rotation.x = THREE.MathUtils.lerp(player.glideRightArm.rotation.x, (player.isGliding ? 1.18 : (airPose ? -0.48 : 0)) + (movingOnGround ? armSwing : 0), Math.min(1, delta * 12));
                }
                if (player.parachuteRig) {
                    player.parachuteRig.visible = player.isGliding;
                    if (player.isGliding) {
                        const sway = Math.sin(performance.now() * 0.0028) * 0.10;
                        player.parachuteRig.rotation.z = sway;
                        player.parachuteRig.rotation.x = Math.sin(performance.now() * 0.0019) * 0.035;
                        player.parachuteRig.scale.set(1 + Math.sin(performance.now() * 0.004) * 0.025, 1, 1);
                    } else {
                        player.parachuteRig.rotation.set(0, 0, 0);
                        player.parachuteRig.scale.set(1, 1, 1);
                    }
                }
                if (player.glideLeftArm && player.glideRightArm) {
                    const armPose = player.isGliding ? 0.82 : 0;
                    player.glideLeftArm.rotation.z = armPose;
                    player.glideRightArm.rotation.z = -armPose;
                }

                // 대시 불꽃은 캐릭터 뒤쪽에서 빠르게 흔들리며 사라짐
                if (player.dashFlameRig) {
                    const dashActive = player.dashVisualTimer > 0;
                    player.dashFlameRig.visible = dashActive;
                    if (dashActive) {
                        const t = performance.now() * 0.025;
                        player.dashFlameRig.scale.set(
                            0.85 + Math.sin(t) * 0.18,
                            0.85 + Math.cos(t * 1.3) * 0.20,
                            0.85 + Math.sin(t * 0.8) * 0.18
                        );
                        player.dashFlameRig.rotation.y = Math.sin(t * 0.7) * 0.10;
                    }
                }

                // 포션을 입 쪽으로 들어 올렸다가 내리고, 버프 중에는 몸 전체가 빛남
                if (player.potionRig) {
                    const drinking = player.potionAnimTimer > 0;
                    player.potionRig.visible = drinking;
                    if (drinking) {
                        const progress = 1 - player.potionAnimTimer / 0.9;
                        const lift = Math.sin(Math.min(1, progress * 1.5) * Math.PI / 2);
                        player.potionRig.position.set(0.48, 1.02 + lift * 0.62, -0.30 - lift * 0.20);
                        player.potionRig.rotation.set(-lift * 0.72, 0, -0.18 - lift * 0.35);
                    } else {
                        player.potionRig.position.set(0.48, 1.02, -0.30);
                        player.potionRig.rotation.set(0, 0, 0);
                    }
                }
                if (player.sprintAura) {
                    const auraActive = player.sprintBoostTimer > 0;
                    player.sprintAura.visible = auraActive;
                    if (auraActive) {
                        const pulse = 0.14 + (Math.sin(performance.now() * 0.009) + 1) * 0.055;
                        player.sprintAura.material.opacity = pulse;
                        const scale = 1 + Math.sin(performance.now() * 0.006) * 0.035;
                        player.sprintAura.scale.setScalar(scale);
                    }
                }
            }

            const orbitYaw = player.rotationY + cameraOrbitYaw;
            const horizontalDistance = cameraDistance * Math.cos(cameraOrbitPitch);
            const targetCamPos = player.position.clone().add(new THREE.Vector3(
                Math.sin(orbitYaw) * horizontalDistance,
                1.7 - Math.sin(cameraOrbitPitch) * cameraDistance,
                Math.cos(orbitYaw) * horizontalDistance
            ));
            camera.position.lerp(targetCamPos, 0.22);
            camera.lookAt(player.position.clone().add(new THREE.Vector3(
                0, 1.25 + Math.sin(cameraOrbitPitch) * 2.2, 0
            )));
        }

        function checkPlatformCollisions(delta = 0.016) {
            const wasGrounded = player.isGrounded;
            player.isGrounded = false;
            player.isTouchingWall = false;
            player.groundVelocity.set(0, 0, 0);

            const playerBox = new THREE.Box3().setFromCenterAndSize(
                player.position.clone().add(new THREE.Vector3(0, player.height / 2, 0)),
                new THREE.Vector3(player.radius * 2.2, player.height + 0.08, player.radius * 2.2)
            );

            for (let plat of platforms) {
                if (!plat.visible) continue;
                const platBox = new THREE.Box3().setFromObject(plat);
                if (playerBox.intersectsBox(platBox)) {
                    if (plat.userData.isGoal) {
                        const finalBoss = bosses.find(b => b.userData.stage === 20);
                        if (finalBoss && !finalBoss.userData.defeated) {
                            showToast('공허의 감시자를 먼저 쓰러뜨리세요! 핵이 황금빛일 때 E 대시!');
                            player.position.z = plat.position.z + 8.5;
                            player.velocity.set(0, 0, 0);
                            return;
                        }
                        onGameClear();
                        return;
                    }

                    if (plat.userData.isBouncePad && player.velocity.y <= 0) {
                        player.velocity.y = 22.5;
                        player.canDoubleJump = true;
                        player.coyoteTimer = 0;
                        playSfx('bounce');
                        showToast("잠자리 바람 점프대 가동!");
                        continue;
                    }

                    const prevY = player.position.y - player.velocity.y * delta;
                    // 이동 중 미세한 프레임 오차로 바닥 판정이 풀리지 않도록 여유 오차(0.55) 적용
                    if (prevY >= platBox.max.y - 0.55 && player.velocity.y <= 0.5) {
                        player.position.y = platBox.max.y;
                        player.velocity.y = 0;
                        player.isGrounded = true;
                        player.canDoubleJump = true;
                        player.coyoteTimer = CONFIG.coyoteTime;

                        if (plat.userData.frameDeltaPos) {
                            player.groundVelocity.copy(plat.userData.frameDeltaPos).divideScalar(Math.max(delta, 0.001));
                        }

                        if (plat.userData.isCrumbling && !plat.userData.triggered) {
                            plat.userData.triggered = true;
                        }
                    } else if (plat.userData.isWall && !player.isGrounded) {
                        player.isTouchingWall = true;
                        const pCenter = player.position.clone();
                        const wCenter = plat.position.clone();
                        const diff = pCenter.sub(wCenter);
                        if (Math.abs(diff.x) > Math.abs(diff.z)) {
                            player.wallNormal.set(Math.sign(diff.x), 0, 0);
                        } else {
                            player.wallNormal.set(0, 0, Math.sign(diff.z));
                        }
                    }
                }
            }

            // 방금 발판 끝에서 벗어났다면 코요테 타임 시작
            if (wasGrounded && !player.isGrounded && player.velocity.y <= 0) {
                player.coyoteTimer = CONFIG.coyoteTime;
            }

            if (canyonDoorSwitch && player.position.distanceTo(canyonDoorSwitch.position) < 1.6 && !canyonDoorState.isOpen) {
                canyonDoorState.isOpening = true;
                canyonDoorSwitch.material.emissiveIntensity = 1.4;
                playSfx('checkpoint');
                showToast("성문 스위치 작동! 협곡 문이 열립니다.");
            }

            if (canyonTrapSwitch && player.position.distanceTo(canyonTrapSwitch.position) < 1.5 && !canyonTrapState.isTriggered) {
                canyonTrapState.isTriggered = true;
                canyonTrapSwitch.position.y -= 0.1;
                showToast("주의! 함정 스위치를 밟아 다리가 무너집니다!");
            }

            if (smaSwitchMesh && player.position.distanceTo(smaSwitchMesh.position) < 2.0 && !smaGateState.isOpen) {
                smaGateState.isHeating = true;
                showToast("불개미 열반응 스위치 작동! 유적 문 개방 중...");
            }
        }

        function updateCanyonMechanics(delta) {
            if (canyonDoorState.isOpening && !canyonDoorState.isOpen) {
                if (canyonDoorMesh.position.y < 16) {
                    canyonDoorMesh.position.y += delta * 8;
                } else {
                    canyonDoorState.isOpen = true;
                }
            }

            if (canyonTrapState.isTriggered && canyonTrapFloor) {
                if (canyonTrapState.rotAngle < Math.PI / 2) {
                    canyonTrapState.rotAngle += delta * 4;
                    canyonTrapFloor.rotation.x = canyonTrapState.rotAngle;
                    canyonTrapFloor.position.y -= delta * 5;
                }
            }
        }

        function updateSMAGate(delta) {
            if (smaGateState.isHeating && !smaGateState.isOpen) {
                smaGateState.heatProgress += delta * 1.5;
                smaSwitchMesh.material.emissiveIntensity = 0.4 + smaGateState.heatProgress * 0.9;
                smaCoilMesh.rotation.z += delta * 6;

                if (smaGateState.heatProgress >= 1.0) {
                    smaGateState.isOpen = true;
                    playSfx('checkpoint');
                    showToast("유적 격벽이 완전히 열렸습니다!");
                }
            }

            if (smaGateState.isOpen && smaGateDoor.position.y < 32) {
                smaGateDoor.position.y += delta * 8;
            }
        }

        const tutorialPrompts = [
            { z: -7, title: '① 이동 연습', body: 'WASD 또는 방향키(모바일은 왼쪽 조이스틱)로 앞으로 이동하세요. 첫 발판까지 걸어가며 방향 전환도 연습해 보세요.' },
            { z: -15, title: '② 점프 연습', body: '갈라진 발판 앞에서 Space(점프 버튼)를 눌러 점프하세요. 발판 중앙에 착지하면 다음 구간으로 이어집니다.' },
            { z: -24, title: '③ 2단 점프 연습', body: '첫 점프 후 공중에서 Space를 한 번 더 누르세요. 무너지는 발판을 빠르게 건너는 데 유용합니다.' },
            { z: -32, title: '④ 활공 연습', body: '발판에서 뛰어내린 뒤 C(활공 버튼)를 누르고 유지하세요. 낙하 속도를 줄여 다음 발판을 향해 이동할 수 있습니다.' },
            { z: -40, title: '⑤ 질풍 대시 연습', body: 'E(대시 버튼)를 눌러 짧은 순간 빠르게 전진하세요. 좁은 간격을 넘을 때 사용하고, 붉은 레이저나 가시에 닿지 않도록 착지 위치를 조절하세요.' },
            { z: -46, title: '⑥ 체크포인트', body: '초록 캠프 아치를 통과하면 부활 지점이 저장됩니다. 이후 함정에 쓰러져도 마지막 캠프에서 다시 시작합니다.' }
        ];
        const tutorialPromptSeen = new Set();
        let tutorialCardOpen = false;
        function updateTutorialPrompts() {
            if (player.currentCpIndex > 1 || tutorialCardOpen) return;
            const z = player.position.z;
            const next = tutorialPrompts.find((item, index) => !tutorialPromptSeen.has(index) && z <= item.z);
            if (!next) return;
            const index = tutorialPrompts.indexOf(next);
            tutorialPromptSeen.add(index);
            document.getElementById('tutorial-card-title').innerText = next.title;
            document.getElementById('tutorial-card-body').innerText = next.body;
            document.getElementById('tutorial-card').classList.remove('hidden');
            tutorialCardOpen = true;
        }
        function closeTutorialCard(event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            const card = document.getElementById('tutorial-card');
            if (!card || card.classList.contains('hidden')) return;
            card.classList.add('hidden');
            tutorialCardOpen = false;
            // 튜토리얼을 닫으면 즉시 게임을 재개합니다.
            isGameRunning = true;
            if (clock) clock.getDelta();
        }
        const tutorialCloseButton = document.getElementById('tutorial-card-close');
        tutorialCloseButton.addEventListener('click', closeTutorialCard);
        // 모바일 터치 환경에서도 버튼 입력이 확실히 전달되도록 처리합니다.
        tutorialCloseButton.addEventListener('pointerup', (event) => {
            if (event.pointerType === 'touch' || event.pointerType === 'pen') {
                closeTutorialCard(event);
            }
        });

        function updateDynamicTraps(delta) {
            scene.traverse((obj) => {
                if (obj.userData && obj.userData.isLaserBeam) {
                    obj.rotation.y += delta * (obj.userData.spinSpeed || 2.1) * 0.45;
                    const dx = player.position.x - obj.position.x;
                    const dz = player.position.z - obj.position.z;
                    const halfLen = (obj.userData.laserLength || 7) / 2;
                    const ux = Math.cos(obj.rotation.y), uz = -Math.sin(obj.rotation.y);
                    const along = THREE.MathUtils.clamp(dx * ux + dz * uz, -halfLen, halfLen);
                    const nearX = obj.position.x + ux * along;
                    const nearZ = obj.position.z + uz * along;
                    const beamDistance = Math.hypot(player.position.x - nearX, player.position.z - nearZ);
                    if (beamDistance < 0.62 && Math.abs((player.position.y + 0.9) - obj.position.y) < 0.95) {
                        onPlayerDie();
                    }
                }
                if (obj.userData && obj.userData.isWindmill) {
                    obj.rotation.z += delta * 2.2;
                    const dx = player.position.x - obj.position.x;
                    const dy = (player.position.y + 0.9) - obj.position.y;
                    const dz = Math.abs(player.position.z - obj.position.z);
                    if (dz < 0.8 && Math.hypot(dx, dy) < 4.6) {
                        const bladeAngle = obj.rotation.z;
                        const playerAngle = Math.atan2(dy, dx);
                        const hitCheck = Math.abs(Math.sin((bladeAngle - playerAngle) * 2));
                        if (hitCheck < 0.22) {
                            player.velocity.y = 8;
                            player.velocity.z = 11;
                            playSfx('die');
                            showToast("풍차 날개에 튕겨났습니다!");
                        }
                    }
                }
                if (obj.userData && obj.userData.isPortal) {
                    obj.rotation.y += delta * 1.4;
                }
                if (obj.userData && obj.userData.isFloorTrap) {
                    obj.userData.timer += delta;
                    obj.material.color.setHex(Math.sin(obj.userData.timer * 4) > 0 ? 0xef4444 : 0x7f1d1d);
                    const nearTrap = Math.abs(player.position.x - obj.position.x) < 2.0 &&
                                     Math.abs(player.position.z - obj.position.z) < 2.0 &&
                                     Math.abs(player.position.y - obj.position.y) < 2.3;
                    if (nearTrap && Math.sin(obj.userData.timer * 4) > 0.45) onPlayerDie();
                }
                if (obj.userData && obj.userData.isSpikeStrip) {
                    const near = Math.abs(player.position.x - obj.position.x) < obj.userData.width / 2 + 0.35 &&
                                 Math.abs(player.position.z - obj.position.z) < obj.userData.depth / 2 + 0.45 &&
                                 Math.abs(player.position.y - obj.position.y) < 0.82;
                    if (near) onPlayerDie();
                }
                if (obj.userData && obj.userData.isCrusher) {
                    obj.userData.phase += delta * 3.2;
                    obj.position.y = obj.userData.baseY + Math.max(0, Math.sin(obj.userData.phase)) * 3.8;
                    if (Math.abs(player.position.x - obj.position.x) < 1.9 &&
                        Math.abs(player.position.z - obj.position.z) < 1.9 &&
                        Math.abs((player.position.y + 0.9) - obj.position.y) < 1.25) onPlayerDie();
                }
                if (obj.userData && obj.userData.isElectricField) {
                    obj.userData.timer += delta;
                    const live = (obj.userData.timer % 2.4) > 1.15;
                    obj.material.color.setHex(live ? 0xff2020 : 0x2563eb);
                    obj.material.emissive.setHex(live ? 0x991b1b : 0x1d4ed8);
                    if (live && Math.abs(player.position.x - obj.position.x) < obj.userData.w / 2 + 0.35 &&
                        Math.abs(player.position.z - obj.position.z) < obj.userData.d / 2 + 0.35 &&
                        Math.abs(player.position.y - obj.position.y) < 1.35) onPlayerDie();
                }
            });

            // Boss encounters: telegraphed core windows and aimed energy shots.
            for (const boss of bosses) {
                const data = boss.userData;
                if (data.defeated) continue;
                data.phase += delta;
                boss.position.y = data.baseY + Math.sin(data.phase * 1.8) * 0.65;
                boss.rotation.y += delta * 0.75;
                data.attackTimer -= delta;
                data.vulnerableTimer = Math.max(0, data.vulnerableTimer - delta);
                const isOpen = data.vulnerableTimer > 0;
                data.core.material.color.setHex(isOpen ? 0xffd700 : 0x64748b);
                data.shellMat.emissiveIntensity = isOpen ? 1.25 : 0.45;
                if (data.attackTimer <= 0) {
                    data.attackTimer = 4.4;
                    data.vulnerableTimer = 2.4;
                    const orb = new THREE.Mesh(new THREE.OctahedronGeometry(0.48, 0), new THREE.MeshBasicMaterial({ color: data.stage === 10 ? 0xff5a36 : 0xc084fc }));
                    orb.position.copy(boss.position);
                    const aim = player.position.clone().add(new THREE.Vector3(0, 0.9, 0)).sub(orb.position).normalize();
                    orb.userData = { velocity: aim.multiplyScalar(8.2), life: 4.5 };
                    scene.add(orb);
                    bossProjectiles.push(orb);
                }
            }
            for (let i = bossProjectiles.length - 1; i >= 0; i--) {
                const orb = bossProjectiles[i];
                orb.position.addScaledVector(orb.userData.velocity, delta);
                orb.rotation.x += delta * 3;
                orb.rotation.y += delta * 4;
                orb.userData.life -= delta;
                if (orb.position.distanceTo(player.position.clone().add(new THREE.Vector3(0, 0.9, 0))) < 1.25) onPlayerDie();
                if (orb.userData.life <= 0 || orb.position.y < -10) {
                    scene.remove(orb);
                    bossProjectiles.splice(i, 1);
                }
            }

            // Gentle Bobbing Animation for Floating Sky Islands
            for (let island of floatingIslands) {
                island.position.y = island.userData.baseY + Math.sin(gameTime * island.userData.speed + island.userData.phase) * 0.45;
            }

            for (const monster of fireMonsters) {
                const data = monster.userData;
                data.phase += delta;
                monster.position.x = data.baseX + Math.sin(data.phase * 0.9) * 5.2;
                monster.position.y = data.baseY + Math.sin(data.phase * 2.1) * 1.1;
                monster.rotation.z = Math.sin(data.phase * 1.7) * 0.12;
                data.fireTimer += delta;
                const firing = (data.fireTimer % 3.2) > 1.65;
                data.flame.visible = firing;
                data.flame.scale.set(0.85 + Math.sin(data.phase * 18) * 0.12, 1, 0.85 + Math.sin(data.phase * 18) * 0.12);
                if (firing) {
                    const flameX = monster.position.x;
                    const flameZ = monster.position.z + 2.1;
                    if (Math.abs(player.position.x - flameX) < 1.65 &&
                        Math.abs(player.position.z - flameZ) < 2.0 &&
                        Math.abs(player.position.y - monster.position.y) < 1.8) {
                        onPlayerDie();
                    }
                }
            }

            for (let plat of crumblingPlats) {
                if (plat.userData.triggered) {
                    plat.userData.timer += delta;
                    plat.position.x += (Math.random() - 0.5) * 0.1;

                    if (plat.userData.timer >= plat.userData.crumbleDelay) {
                        plat.position.y -= 15 * delta;
                        if (plat.position.y < -30) plat.visible = false;
                    }
                }
            }

            for (let plat of movingPlats) {
                const prevPos = plat.position.clone();
                plat.userData.progress += delta * plat.userData.speed;
                const offset = Math.sin(plat.userData.progress);
                plat.position.copy(plat.userData.startPos).addScaledVector(plat.userData.moveVector, offset);
                plat.userData.frameDeltaPos = plat.position.clone().sub(prevPos);
            }

            if (chaseWall && player.position.z < -120 && player.position.z > -270) {
                chaseWall.visible = true;
                chaseWall.position.z -= 6.2 * delta;
                if (Math.abs(player.position.z - chaseWall.position.z) < 1.5) {
                    onPlayerDie();
                }
            }

            if (confettiParticles.length > 0) {
                for (let p of confettiParticles) {
                    p.position.add(p.userData.velocity);
                    p.userData.velocity.y -= 0.005;
                    p.rotation.x += 0.05;
                    p.rotation.y += 0.05;
                }
            }
        }

        function checkCollectibles() {
            for (let token of tokens) {
                if (token.visible) {
                    token.rotation.y += 0.04;
                    token.position.y += Math.sin(gameTime * 4 + token.userData.sampleIndex) * 0.004;
                    if (player.position.distanceTo(token.position) < 1.6) {
                        token.visible = false;
                        player.tokensCollected++;
                        const idx = token.userData.sampleIndex;
                        unlockedSamples.add(idx);
                        playSfx('token');

                        const sampleInfo = FIELDBOOK_DATA[idx];
                        showToast(`필드북 등록: [${sampleInfo.code}] ${sampleInfo.name}!`);

                        document.getElementById('fieldbook-dot').classList.remove('hidden');
                        document.getElementById('btn-open-fieldbook').classList.add('new-entry-badge');
                    }
                }
            }

            for (let cp of checkpoints) {
                if (!cp.activated && player.position.distanceTo(cp.position) < 2.6) {
                    const guardian10 = bosses.find(b => b.userData.stage === 10);
                    const guardian20 = bosses.find(b => b.userData.stage === 20);
                    if (cp.index === 11 && guardian10 && !guardian10.userData.defeated) {
                        showToast('10단계 보스를 먼저 격파해야 다음 캠프가 열립니다!');
                        continue;
                    }
                    if (cp.index === 20 && guardian20 && !guardian20.userData.defeated) {
                        showToast('20단계 보스를 먼저 격파해야 최종 캠프가 열립니다!');
                        continue;
                    }
                    cp.activated = true;
                    cp.postMat.color.setHex(0x4e8c37);
                    cp.postMat.emissive.setHex(0x1b4314);
                    player.currentCheckpoint.copy(cp.position);
                    player.currentCpIndex = cp.index;
                    playSfx('checkpoint');
                    showToast(`캠프 체크포인트 ${cp.index} 저장 완료!`);
                    updateQuestTracker(cp.index);

                    if (cp.index >= 8) {
                        document.getElementById('hud-stage-badge').innerText = 'SANCTUARY';
                        document.getElementById('hud-stage-badge').className = 'text-[11px] px-1.5 py-0.5 pixel-green-badge font-bold';
                    } else if (cp.index >= 4) {
                        document.getElementById('hud-stage-badge').innerText = 'SKY RUINS';
                        document.getElementById('hud-stage-badge').className = 'text-[11px] px-1.5 py-0.5 pixel-amber-badge font-bold';
                    }
                }
            }
        }

        /* ==========================================
           GAME FLOW CONTROLLER
        ========================================== */
        function startGame() {
            playerCustom.nickname = document.getElementById('custom-nickname').value.trim() || 'YVES-SCOUT';
            document.getElementById('player-nickname-display').innerText = playerCustom.nickname;
            createPlayerMesh();
            restartGameCompletely();
        }

        function restartGameCompletely() {
            gameTime = 0;
            tutorialPromptSeen.clear();
            tutorialCardOpen = false;
            document.getElementById('tutorial-card').classList.add('hidden');
            for (const boss of bosses) {
                boss.userData.hp = boss.userData.maxHp;
                boss.userData.defeated = false;
                boss.userData.attackTimer = 2.6;
                boss.userData.vulnerableTimer = 0;
                boss.visible = true;
                boss.userData.shellMat.emissiveIntensity = 0.45;
                boss.userData.core.material.color.setHex(0x64748b);
            }
            for (const orb of bossProjectiles) scene.remove(orb);
            bossProjectiles.length = 0;
            player.tokensCollected = 0;
            player.currentCheckpoint.set(0, 5, 0);
            player.currentCpIndex = 0;
            updateQuestTracker(0);

            // Reset Canyon Puzzle
            canyonDoorState = { isOpening: false, isOpen: false };
            if (canyonDoorMesh) canyonDoorMesh.position.set(0, 8, -64);
            if (canyonDoorSwitch) canyonDoorSwitch.material.emissiveIntensity = 0.6;

            canyonTrapState = { isTriggered: false, rotAngle: 0 };
            if (canyonTrapFloor) {
                canyonTrapFloor.position.set(0, 3, -90);
                canyonTrapFloor.rotation.x = 0;
            }
            if (canyonTrapSwitch) canyonTrapSwitch.position.set(0, 3.6, -81);

            // Reset SMA Gate
            smaGateState = { isHeating: false, heatProgress: 0, isOpen: false };
            if (smaGateDoor) smaGateDoor.position.set(0, 23, -162);
            if (smaSwitchMesh) smaSwitchMesh.material.emissiveIntensity = 0.4;

            for (let plat of crumblingPlats) {
                plat.userData.triggered = false;
                plat.userData.timer = 0;
                plat.position.y = plat.userData.initialY;
                plat.visible = true;
            }

            for (let cp of checkpoints) {
                cp.activated = false;
                cp.postMat.color.setHex(0xf59e0b);
                cp.postMat.emissive.setHex(0x92400e);
            }
            for (let token of tokens) token.visible = true;
            for (const monster of fireMonsters) {
                monster.userData.phase = 0;
                monster.userData.fireTimer = 0;
                monster.position.set(monster.userData.baseX, monster.userData.baseY, -493);
                monster.userData.flame.visible = false;
            }

            if (chaseWall) {
                chaseWall.position.set(0, 10, -125);
                chaseWall.visible = false;
            }

            document.getElementById('hud-stage-badge').innerText = 'FOREST 01';
            document.getElementById('hud-stage-badge').className = 'text-[11px] px-1.5 py-0.5 pixel-green-badge font-bold';

            respawnPlayer();
            showToast("필드 채집 탐사가 시작되었습니다!");
        }

        function respawnPlayer() {
            player.position.copy(player.currentCheckpoint);
            player.velocity.set(0, 0, 0);
            player.coyoteTimer = 0;
            player.jumpBufferTimer = 0;
            player.sprintBoostTimer = 0;
            player.isGliding = false;
            player.glideQueued = false;
            player.isSliding = false;
            player.stamina = CONFIG.maxStamina;
            player.staminaRegenTimer = 0;

            document.getElementById('menu-modal').classList.add('hidden');
            document.getElementById('modal-content-start').classList.add('hidden');
            document.getElementById('modal-content-die').classList.add('hidden');
            document.getElementById('modal-content-clear').classList.add('hidden');

            isGameRunning = true;
        }

        function teleportTo(targetCp) {
            let targetPos = new THREE.Vector3(0, 5, 0);
            if (targetCp === 'goal') {
                targetPos.set(0, 120, -944);
                updateQuestTracker(7);
            } else {
                const idx = parseInt(targetCp);
                if (checkpoints[idx]) {
                    targetPos.copy(checkpoints[idx].position);
                    targetPos.y += 0.6;
                    updateQuestTracker(idx);
                }
            }

            player.position.copy(targetPos);
            player.velocity.set(0, 0, 0);
            player.isGrounded = false;
            player.dashCooldown = 0;
            player.dashVisualTimer = 0;
            player.potionAnimTimer = 0;
            player.sprintBoostTimer = 0;
            player.wallJumpCooldown = 0;

            document.getElementById('menu-modal').classList.add('hidden');
            document.getElementById('modal-content-die').classList.add('hidden');
            isGameRunning = true;

            showToast(`[DEV] 구역 워프 완료: ${targetCp.toUpperCase()}`);
        }

        function triggerConfettiBurst() {
            const colors = [0xfacc15, 0x4e8c37, 0xf97316, 0x38bdf8, 0xef4444];
            for (let i = 0; i < 120; i++) {
                const pGeo = new THREE.PlaneGeometry(0.32, 0.32);
                const pMat = new THREE.MeshBasicMaterial({
                    color: colors[Math.floor(Math.random() * colors.length)],
                    side: THREE.DoubleSide
                });
                const particle = new THREE.Mesh(pGeo, pMat);
                particle.position.copy(player.position).add(new THREE.Vector3(0, 2, 0));
                particle.userData.velocity = new THREE.Vector3(
                    (Math.random() - 0.5) * 0.6,
                    Math.random() * 0.5 + 0.3,
                    (Math.random() - 0.5) * 0.6
                );
                scene.add(particle);
                confettiParticles.push(particle);
            }
        }

        function onPlayerDie() {
            if (!isGameRunning) return;
            isGameRunning = false;
            playSfx('die');
            document.getElementById('menu-modal').classList.remove('hidden');
            document.getElementById('modal-content-die').classList.remove('hidden');
        }

        function onGameClear() {
            if (!isGameRunning) return;
            isGameRunning = false;
            playSfx('clear');
            triggerConfettiBurst();

            const formattedTime = formatTime(gameTime);
            if (!bestTime || gameTime < bestTime) {
                bestTime = gameTime;
            }

            document.getElementById('final-time').innerText = formattedTime;
            document.getElementById('final-tokens').innerText = `${unlockedSamples.size} / 10 종`;
            document.getElementById('best-time').innerText = formatTime(bestTime);
            document.getElementById('quest-progress-badge').innerText = '완료!';
            document.getElementById('quest-progress-badge').className = 'text-[10px] pixel-green-badge px-1.5 py-0.5 font-bold';

            document.getElementById('menu-modal').classList.remove('hidden');
            document.getElementById('modal-content-clear').classList.remove('hidden');
        }

        function showToast(msg) {
            // 반복적인 조작 안내는 화면에 띄우지 않고, 중요한 진행/위험 알림만 표시
            const quietMessages = [
                '도트 그래픽 모드', '칩튠 효과음',
                '게코 벽타기 도약', '코요테 점프', '2단 점프',
                '질풍 대시', '슬라이딩', '공중 활공',
                '수직 급강하', '필드북 등록', '필드 채집 탐사가 시작'
            ];
            if (quietMessages.some(text => String(msg).includes(text))) return;
            const toast = document.getElementById('toast-message');
            document.getElementById('toast-text').innerText = msg;
            toast.classList.remove('opacity-0', 'translate-y-16');
            toast.classList.add('opacity-100', 'translate-y-16');

            clearTimeout(toast.timer);
            toast.timer = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-16');
                toast.classList.add('opacity-0', 'translate-y-16');
            }, 2000);
        }

        function updateHUD() {
            document.getElementById('timer-display').innerText = formatTime(gameTime);
            document.getElementById('stamina-bar').style.width = `${(player.stamina / CONFIG.maxStamina) * 100}%`;
            const speedKmH = Math.round(new THREE.Vector3(player.velocity.x, 0, player.velocity.z).length() * 3.6);
            document.getElementById('speed-display').innerText = speedKmH;
            document.getElementById('token-display').innerText = unlockedSamples.size;

            const activeCps = checkpoints.filter(c => c.activated).length;
            document.getElementById('checkpoint-text').innerText = `CP ${activeCps}/21`;
        }

        function formatTime(seconds) {
            const m = Math.floor(seconds / 60);
            const s = Math.floor(seconds % 60);
            const ms = Math.floor((seconds % 1) * 100);
            return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}.${ms.toString().padStart(2, '0')}`;
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            applyPixelResolution();
        }

        function updateSkyCycle() {
            if (!scene || !scene.background || !scene.background.image) return;
            const tex = scene.background;
            const canvas = tex.image;
            const ctx = canvas.getContext('2d');
            const cycle = (gameTime % 90) / 90;
            const morning = ['#38bdf8','#60a5fa','#7dd3fc','#bae6fd','#fef3c7','#fde68a'];
            const sunset = ['#312e81','#7c2d12','#ea580c','#fb923c','#fbbf24','#fed7aa'];
            const night = ['#020617','#0f172a','#172554','#1e1b4b','#312e81','#4338ca'];
            let bands = morning, sunY = 8, sunX = 46, sunColor = '#fef08a';
            let tint = new THREE.Color(0xfffbeb), sunTint = new THREE.Color(0xfef08a), ambientPower = 0.95, sunPower = 1.4;
            if (cycle < 0.34) {
                const t = cycle / 0.34;
                sunY = 7 + t * 5;
            } else if (cycle < 0.67) {
                const t = (cycle - 0.34) / 0.33;
                bands = sunset; sunY = 8 + t * 35; sunX = 46 - t * 25; sunColor = '#fb923c';
                tint.set(0xffb36b); sunTint.set(0xff7a36); ambientPower = 0.82 - t * 0.22; sunPower = 1.0 - t * 0.55;
            } else {
                bands = night; sunY = -20; ambientPower = 0.42; sunPower = 0.12;
                tint.set(0x7185c8); sunTint.set(0x8ab4ff);
            }
            ctx.imageSmoothingEnabled = false;
            ctx.clearRect(0,0,64,64);
            const h = Math.ceil(64 / bands.length);
            bands.forEach((col,i) => { ctx.fillStyle = col; ctx.fillRect(0,i*h,64,h); });
            if (cycle >= 0.67) {
                // Pixel stars twinkle during the night segment.
                for (let i=0;i<24;i++) {
                    const x = (i*17 + 7) % 64, y = (i*23 + 5) % 42;
                    ctx.fillStyle = (Math.floor(gameTime*2+i)%3===0) ? '#ffffff' : '#c7d2fe';
                    ctx.fillRect(x,y,1,1);
                }
                ctx.fillStyle = '#f8fafc'; ctx.fillRect(47,8,7,7);
                ctx.fillStyle = '#cbd5e1'; ctx.fillRect(49,8,5,7);
                ctx.clearRect(49,8,2,2);
            } else {
                ctx.fillStyle = sunColor; ctx.fillRect(Math.round(sunX),Math.round(sunY),8,8);
                ctx.fillStyle = '#fff7ed'; ctx.fillRect(Math.round(sunX)+2,Math.round(sunY)+2,4,4);
            }
            if (cycle < 0.67) {
                ctx.fillStyle = cycle < 0.34 ? '#ffffff' : '#fed7aa';
                ctx.fillRect(8,14,12,3); ctx.fillRect(10,12,8,2); ctx.fillRect(28,22,14,3); ctx.fillRect(31,20,8,2);
            }
            tex.needsUpdate = true;
            scene.fog.color.copy(new THREE.Color(cycle >= 0.67 ? 0x101a3b : cycle >= 0.34 ? 0x9a4b3b : 0x93c5fd));
            if (scene.userData.cycleAmbient) { scene.userData.cycleAmbient.color.copy(tint); scene.userData.cycleAmbient.intensity = ambientPower; }
            if (scene.userData.cycleSun) { scene.userData.cycleSun.color.copy(sunTint); scene.userData.cycleSun.intensity = sunPower; }
            if (cycle < 0.34) document.getElementById('hud-stage-badge').dataset.sky = 'MORNING';
            else if (cycle < 0.67) document.getElementById('hud-stage-badge').dataset.sky = 'SUNSET';
            else document.getElementById('hud-stage-badge').dataset.sky = 'NIGHT';
        }

        function animate() {
            requestAnimationFrame(animate);
            const delta = Math.min(clock.getDelta(), 0.1);

            if (isGameRunning) {
                updatePhysics(delta);
                updateTutorialPrompts();
                updateHUD();
            }
            updateSkyCycle();

            if (scene.userData.updateParticles) scene.userData.updateParticles(delta);

            renderer.render(scene, camera);
        }

        window.onload = () => {
            initScene();
            setupControls();
            animate();
        };
    </script>
