        /* ==========================================
           PIXEL SKY BACKDROP & VOXEL FOREST SCENERY
        ========================================== */
        function createPixelSkyTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 64;
            canvas.height = 64;
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;

            // Banded pixel sky gradient
            const bands = ['#38bdf8', '#60a5fa', '#7dd3fc', '#bae6fd', '#fef3c7', '#fde68a'];
            const bandH = Math.ceil(64 / bands.length);
            bands.forEach((col, i) => {
                ctx.fillStyle = col;
                ctx.fillRect(0, i * bandH, 64, bandH);
            });

            // Pixel Sun
            ctx.fillStyle = '#fef08a';
            ctx.fillRect(46, 8, 8, 8);
            ctx.fillStyle = '#ffffff';
