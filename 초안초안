    <script>
        /* ==========================================
           PROCEDURAL PIXEL ART SPRITE & TEXTURE GENERATOR
           (Generates authentic crisp NearestFilter pixel textures!)
        ========================================== */
        function createPixelTexture(width, height, drawFn) {
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;
            drawFn(ctx, width, height);

            const tex = new THREE.CanvasTexture(canvas);
            tex.magFilter = THREE.NearestFilter;
            tex.minFilter = THREE.NearestFilter;
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            return tex;
        }

        // Generate Pixel Art Textures for 3D World
        const PIXEL_TEXTURES = {};

        function initPixelTextures() {
            // 1. Lush Forest Grass & Dirt Top Texture (16x16 pixel grid)
            PIXEL_TEXTURES.grass = createPixelTexture(16, 16, (ctx, w, h) => {
                ctx.fillStyle = '#4e8c37';
                ctx.fillRect(0, 0, w, h);
                const shades = ['#3c7029', '#65ab48', '#7cc45c', '#457d30'];
                for (let y = 0; y < h; y++) {
                    for (let x = 0; x < w; x++) {
                        if ((x * 7 + y * 13) % 5 === 0) {
                            ctx.fillStyle = shades[(x + y) % shades.length];
                            ctx.fillRect(x, y, 1, 1);
                        }
                    }
                }
                // Tiny yellow/white wildflowers
                ctx.fillStyle = '#fef08a';
                ctx.fillRect(3, 4, 1, 1);
                ctx.fillRect(11, 12, 1, 1);
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(12, 3, 1, 1);
            });

            // 2. Oak Wood Plank Texture (16x16)
            PIXEL_TEXTURES.wood = createPixelTexture(16, 16, (ctx, w, h) => {
                ctx.fillStyle = '#7c4d25';
                ctx.fillRect(0, 0, w, h);
                ctx.fillStyle = '#5c3616';
                ctx.fillRect(0, 3, w, 1);
                ctx.fillRect(0, 7, w, 1);
                ctx.fillRect(0, 11, w, 1);
                ctx.fillRect(0, 15, w, 1);
                ctx.fillStyle = '#966133';
                ctx.fillRect(0, 1, w, 1);
                ctx.fillRect(0, 9, w, 1);
                // Wood nails
                ctx.fillStyle = '#2e1a0a';
                ctx.fillRect(2, 2, 1, 1);
                ctx.fillRect(13, 6, 1, 1);
                ctx.fillRect(4, 10, 1, 1);
            });

            // 3. Mossy Cobblestone Texture (16x16)
            PIXEL_TEXTURES.stone = createPixelTexture(16, 16, (ctx, w, h) => {
                ctx.fillStyle = '#6b7280';
                ctx.fillRect(0, 0, w, h);
                ctx.fillStyle = '#4b5563';
                ctx.fillRect(0, 0, 7, 7);
                ctx.fillRect(8, 8, 7, 7);
                ctx.fillStyle = '#9ca3af';
                ctx.fillRect(1, 1, 5, 1);
                ctx.fillRect(9, 9, 5, 1);
                // Moss patches
                ctx.fillStyle = '#4e8c37';
                ctx.fillRect(6, 0, 3, 2);
                ctx.fillRect(0, 7, 4, 2);
                ctx.fillRect(12, 13, 3, 2);
            });

            // 4. Autumn Maple Terracotta Wall (16x16)
            PIXEL_TEXTURES.autumnWall = createPixelTexture(16, 16, (ctx, w, h) => {
                ctx.fillStyle = '#c2410c';
                ctx.fillRect(0, 0, w, h);
                ctx.fillStyle = '#9a3412';
                for (let y = 0; y < h; y += 4) {
                    ctx.fillRect(0, y, w, 1);
                    const offset = (y % 8 === 0) ? 0 : 4;
                    for (let x = offset; x < w; x += 8) {
                        ctx.fillRect(x, y, 1, 4);
                    }
                }
                ctx.fillStyle = '#ea580c';
                ctx.fillRect(2, 1, 4, 1);
                ctx.fillRect(10, 5, 4, 1);
            });

            // 5. Golden Amber & Honey Platform (16x16)
            PIXEL_TEXTURES.gold = createPixelTexture(16, 16, (ctx, w, h) => {
                ctx.fillStyle = '#d97706';
                ctx.fillRect(0, 0, w, h);
                ctx.strokeStyle = '#92400e';
                ctx.lineWidth = 1;
                ctx.strokeRect(0.5, 0.5, w - 1, h - 1);
                ctx.fillStyle = '#fbbf24';
                ctx.fillRect(2, 2, 12, 2);
                ctx.fillRect(2, 2, 2, 12);
                ctx.fillStyle = '#fef08a';
                ctx.fillRect(3, 3, 2, 2);
            });

            // 6. Crumbling Autumn Leaf Block (16x16)
            PIXEL_TEXTURES.crumble = createPixelTexture(16, 16, (ctx, w, h) => {
                ctx.fillStyle = '#b91c1c';
                ctx.fillRect(0, 0, w, h);
                ctx.fillStyle = '#f97316';
                ctx.fillRect(2, 2, 4, 4);
                ctx.fillRect(9, 8, 5, 5);
                ctx.fillStyle = '#facc15';
                ctx.fillRect(10, 2, 3, 3);
                ctx.fillRect(3, 10, 3, 3);
                // Cracks
                ctx.fillStyle = '#450a0a';
                ctx.fillRect(7, 0, 1, 16);
                ctx.fillRect(0, 7, 16, 1);
            });

            // 7. Crystal Sky / Superconductor Stone (16x16)
            PIXEL_TEXTURES.crystal = createPixelTexture(16, 16, (ctx, w, h) => {
                ctx.fillStyle = '#0284c7';
                ctx.fillRect(0, 0, w, h);
                ctx.fillStyle = '#38bdf8';
                ctx.fillRect(2, 2, 5, 5);
                ctx.fillRect(9, 9, 5, 5);
                ctx.fillStyle = '#e0f2fe';
                ctx.fillRect(3, 3, 2, 2);
                ctx.fillRect(10, 10, 2, 2);
            });

            // 8. Floating Island Rich Soil & Root Texture (16x16)
            PIXEL_TEXTURES.dirt = createPixelTexture(16, 16, (ctx, w, h) => {
                ctx.fillStyle = '#6b4226';
                ctx.fillRect(0, 0, w, h);
                const pebbles = ['#4a2c18', '#855331', '#57341c', '#9ca3af'];
                for (let y = 0; y < h; y += 2) {
                    for (let x = 0; x < w; x += 2) {
                        if ((x * 5 + y * 9) % 4 === 0) {
                            ctx.fillStyle = pebbles[(x + y) % pebbles.length];
                            ctx.fillRect(x, y, 2, 2);
                        }
                    }
                }
            });

            // 9. Honeybee Hexagonal Comb Block (16x16)
            PIXEL_TEXTURES.honeycomb = createPixelTexture(16, 16, (ctx, w, h) => {
                ctx.fillStyle = '#f59e0b';
                ctx.fillRect(0, 0, w, h);
                ctx.fillStyle = '#b45309';
                ctx.fillRect(2, 2, 5, 5);
                ctx.fillRect(9, 9, 5, 5);
                ctx.fillStyle = '#fef08a';
                ctx.fillRect(3, 3, 2, 2);
                ctx.fillRect(10, 10, 2, 2);
            });
        }

        /* ==========================================
           PIXEL SPRITE ICON GENERATOR FOR FIELDBOOK CARDS
           (Draws 12x12 pixel-art insect & biomimicry icons!)
        ========================================== */
        function createPixelSpriteDataURL(pattern, palette) {
            const size = pattern.length;
            const scale = 4; // 48x48 crisp pixel art
            const canvas = document.createElement('canvas');
            canvas.width = size * scale;
            canvas.height = size * scale;
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;

            for (let y = 0; y < size; y++) {
                for (let x = 0; x < size; x++) {
                    const ch = pattern[y][x];
                    if (palette[ch]) {
                        ctx.fillStyle = palette[ch];
                        ctx.fillRect(x * scale, y * scale, scale, scale);
                    }
                }
            }
            return canvas.toDataURL();
        }

